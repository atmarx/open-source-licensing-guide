:3000 {
    root * /srv
    file_server
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle_errors {
        respond "{err.status_code} {err.status_text}" {err.status_code}
    }
}
